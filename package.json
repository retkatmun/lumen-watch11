{
  "name": "lumen-watch",
  "version": "0.1.0",
  "description": "Watch Stellar accounts and receive real-time payment alerts via pluggable notifiers",
  "keywords": [
    "stellar",
    "horizon",
    "blockchain",
    "payments",
    "watcher",
    "alerts",
    "typescript"
  ],
  "homepage": "https://github.com/retkatmun/lumen-watch11#readme",
  "bugs": {
    "url": "https://github.com/retkatmun/lumen-watch11/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/retkatmun/lumen-watch11.git"
  },
  "license": "MIT",
  "author": "lumen-watch contributors",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "lumen-watch": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "commander": "12.1.0",
    "node-fetch": "3.3.2",
    "pino": "9.4.0",
    "pino-pretty": "11.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.12.0",
    "@types/node": "20.16.11",
    "@vitest/coverage-v8": "2.1.2",
    "eslint": "9.12.0",
    "prettier": "3.3.3",
    "tsup": "8.3.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.8.1",
    "vitest": "2.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
